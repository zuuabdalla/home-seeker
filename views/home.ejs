<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        color: #111827;
      }
      .hero {
        max-width: 960px;
        margin: 80px auto;
        padding: 40px 28px;
        text-align: center;
        background: white;
        border-radius: 20px;
        box-shadow: 0 12px 28px rgba(15,23,42,.08);
      }
      h1 { font-size: 3rem; margin-bottom: 12px; }
      p { color: #475569; font-size: 1.1rem; }
      a {
        display: inline-block;
        margin-top: 18px;
        text-decoration: none;
        background: #1d4ed8;
        color: white;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <div class="hero">
      <h1>HomeFinder</h1>
      <p>Find a Place You Can Call Home</p>
      <a href="/landlord/properties/add">Go to Landlord Add Property</a>
    </div>
  </body>
</html>
