<header class="site-header-global sticky-top bg-white border-bottom shadow-sm">
  <div class="top-announcement bg-primary text-white py-1 px-3 text-center small fw-medium">
    <span>🇰🇪 HomeFinder Kenya — Search hundreds of verified homes. <strong>No sign-up required to search or contact landlords!</strong></span>
  </div>
  <nav class="navbar navbar-expand-lg navbar-light bg-white py-2">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <span class="brand-logo-badge">H</span>
        <span class="brand-title">HomeFinder</span>
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/properties">Properties</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/properties?listing_type=rent">Rent</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/properties?listing_type=sale">Buy</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/services">Services</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contact">Contact</a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <% if (typeof user !== 'undefined' && user) { %>
            <% if (user.role === 'admin') { %>
              <a href="/admin/dashboard" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-shield-lock"></i> Admin Dashboard
              </a>
            <% } else { %>
              <a href="/landlord/dashboard" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-speedometer2"></i> Dashboard
              </a>
              <a href="/favorites" class="btn btn-light btn-sm text-danger border" title="Saved Favorites">
                <i class="bi bi-heart-fill"></i>
              </a>
            <% } %>

            <div class="dropdown">
              <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar-circle-sm"><%= (user.name || 'User').slice(0, 2).toUpperCase() %></span>
                <span class="d-none d-md-inline fw-semibold"><%= user.name %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><h6 class="dropdown-header text-capitalize"><%= user.role %> Account</h6></li>
                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                <% if (user.role !== 'admin') { %>
                  <li><a class="dropdown-item" href="/landlord/properties"><i class="bi bi-houses me-2"></i>My Properties</a></li>
                  <li><a class="dropdown-item" href="/landlord/inquiries"><i class="bi bi-chat-dots me-2"></i>Inquiries</a></li>
                  <li><a class="dropdown-item" href="/landlord/bookings"><i class="bi bi-calendar-event me-2"></i>Bookings</a></li>
                  <li><a class="dropdown-item" href="/landlord/notifications"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
              </ul>
            </div>

            <a href="/landlord/properties/add" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
              <i class="bi bi-plus-circle"></i> List Property
            </a>
          <% } else { %>
            <a href="/login" class="btn btn-outline-secondary btn-sm">Login</a>
            <a href="/register" class="btn btn-outline-primary btn-sm">Register</a>
            <a href="/landlord/properties/add" class="btn btn-primary btn-sm shadow-sm d-flex align-items-center gap-1">
              <i class="bi bi-house-add"></i> List Property
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
